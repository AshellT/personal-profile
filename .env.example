# Resend API key used by the serverless API route (required for contact form)
RESEND_API_KEY=

# Required: receiver inbox for contact submissions
CONTACT_RECEIVER_EMAIL=ashell.gonese@outlook.com

# Recommended for production: a sender on a domain you verified in Resend
# Example: Ashell Gonese <hello@ashelltinotenda.co.zw>
# Avoid shipping with onboarding@resend.dev for real client traffic
RESEND_FROM_EMAIL="Ashell Gonese <onboarding@resend.dev>"

# Optional: hosted logo URL for branded email headers
RESEND_EMAIL_LOGO_URL=https://ashelltinotenda.co.zw/brand/atg-logo-a-master-512.png

# Optional: Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to keep analytics off
VITE_GA_MEASUREMENT_ID=
